{% use "@Contao/component/_stylesheet.html.twig" %}
{% add "domain_manager_workspace_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-workspace.css') ~ '?v=agency-1'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}
{% add "domain_manager_workspace_js" to body %}
    <script src="{{ asset('bundles/contaodomainmanager/js/domain-manager-workspace.js') ~ '?v=agency-1' }}" defer></script>
{% endadd %}

<div class="dm-workspace-metrics" aria-label="Installationsübersicht">
    <button type="button" data-dm-workspace-scope="all"><strong>{{ workspace_counts.total }}</strong><span>Installationen<small>{{ workspace_groups }} Hauptdomains</small></span></button>
    <button type="button" {% if workspace.pro_enabled %}data-dm-workspace-scope="available"{% else %}class="is-pro-locked" aria-disabled="true" data-dm-pro-hint{% endif %}><strong>{{ workspace.pro_enabled ? workspace_counts.updates : '—' }}</strong><span>Bekannte Updates{% if not workspace.pro_enabled %}<small>Pro</small>{% endif %}</span></button>
    <button type="button" data-dm-workspace-scope="error" class="has-errors"><strong>{{ workspace_counts.problems }}</strong><span>Probleme</span></button>
</div>
<div class="dm-workspace-running"{% if workspace.pro_enabled and workspace_counts.running == 0 %} hidden{% endif %}>
    {% if workspace.pro_enabled %}
        <strong>{{ workspace_counts.running }} {{ workspace_counts.running == 1 ? 'Installation in Bearbeitung' : 'Installationen in Bearbeitung' }}</strong>
        <button type="button" data-dm-workspace-scope="running">Laufende Wartungsaufträge anzeigen</button>
    {% else %}
        <button type="button" class="is-pro-locked" aria-disabled="true" data-dm-pro-hint>Wartungsaufträge verfolgen <span>Pro</span></button>
    {% endif %}
</div>
<div class="dm-workspace-viewbar">
    {% if workspace_mode == 'overview' %}
        <div class="dm-workspace-scopes" role="group" aria-label="Domainübersicht eingrenzen">
            <button type="button" data-dm-workspace-scope="attention">Handlungsbedarf <span>{{ workspace_counts.attention }}</span></button>
            <button type="button" data-dm-workspace-scope="all">Alle Installationen</button>
        </div>
    {% else %}
        <span class="dm-workspace-caption">Installationen nach Dringlichkeit bearbeiten</span>
    {% endif %}
    <div class="dm-workspace-views" role="group" aria-label="Darstellung">
        <button type="button" data-dm-workspace-view="list" aria-pressed="true">Liste</button>
        <button type="button" data-dm-workspace-view="tiles" aria-pressed="false">Kacheln</button>
    </div>
</div>
<div class="dm-pro-hint" data-dm-pro-hint-panel role="status" hidden>
    <div>
        <strong>{% if workspace.pro_available %}Für diesen Zugang nicht freigegeben{% else %}Nur in der Pro-Version möglich{% endif %}</strong>
        <p>{% if workspace.pro_available %}Für diese Pro-Funktion benötigt der angemeldete Benutzer die entsprechenden Bedienrechte.{% else %}Diese Funktion gehört zu maintend Pro.{% endif %}
            <a href="{{ workspace.pro_url|e('html_attr') }}" target="_blank" rel="noopener noreferrer">Abo-Modelle ansehen</a>
        </p>
    </div>
    <button type="button" data-dm-pro-hint-close>Schließen</button>
</div>

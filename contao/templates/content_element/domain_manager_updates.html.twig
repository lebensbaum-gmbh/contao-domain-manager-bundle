{% extends "@Contao/content_element/_base.html.twig" %}

{% use "@Contao/component/_stylesheet.html.twig" %}

{% add "domain_manager_layout_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-layout.css') ~ '?v=maintend-2'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_updates_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-updates.css') ~ '?v=maintend-8'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_navigation_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-navigation.css') ~ '?v=maintend-1'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_layout_js" to body %}
    <script src="{{ asset('bundles/contaodomainmanager/js/domain-manager-layout.js') ~ '?v=1.5.2' }}" defer></script>
{% endadd %}

{% add "domain_manager_updates_js" to body %}
    <script src="{{ asset('bundles/contaodomainmanager/js/domain-manager-updates.js') ~ '?v=agency-1' }}" defer></script>
{% endadd %}

{% macro action(action, request_token) %}
    {% if action.method == 'post' %}
        <form
            class="dm-updates-action-form"
            action="{{ action.url }}"
            method="post"
            data-dm-action="{{ action.name|e('html_attr') }}"
        >
            <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
            <button
                class="dm-updates-action is-{{ action.variant }}"
                type="submit"
                data-dm-action-label="{{ action.label|e('html_attr') }}"
                {% if action.confirm %}data-dm-confirm="{{ action.confirm|e('html_attr') }}"{% endif %}
            >{{ action.label }}</button>
        </form>
    {% else %}
        <a class="dm-updates-action is-{{ action.variant }}" href="{{ action.url }}">{{ action.label }}</a>
    {% endif %}
{% endmacro %}

{% import _self as dm %}

{% block content %}
{% include "@Contao/components/domain_manager_workspace_navigation.html.twig" %}
<div class="dm-updates dm-workspace{% if pro_enabled %} has-selection{% endif %}" data-dm-updates data-dm-workspace="updates" data-dm-workspace-default="{{ pro_enabled ? 'attention' : 'all' }}">
    <header class="dm-updates-head">
        <div>
            <h2>Updates</h2>
            <p>Contao-Installationen zentral prüfen, vorbereiten und sicher aktualisieren.</p>
        </div>
    </header>

    {% include "@Contao/components/domain_manager_workspace_controls.html.twig" with {workspace_mode: "updates"} %}

    {% if not pro_enabled %}
        <div class="dm-updates-pro-teaser">
            <div>
                <strong>Update-Management in der Pro-Version</strong>
                <p>Updates prüfen, verfügbare Updates filtern, Sicherheitsbackups erstellen und Updates direkt installieren.</p>
            </div>
            <div class="dm-updates-pro-actions" aria-label="Pro-Funktionen">
                <button type="button" class="is-pro-locked" aria-disabled="true" data-dm-pro-hint>Updates prüfen <span>Pro</span></button>
                <button type="button" class="is-pro-locked" aria-disabled="true" data-dm-pro-hint>Updates installieren <span>Pro</span></button>
            </div>
        </div>
    {% endif %}

    {% if result_message %}
        <div class="dm-updates-result {{ install_status == 'error' or check_status in ['error', 'blocked'] ? 'is-error' : 'is-success' }}" role="status">
            <strong>{{ result_message }}</strong>
        </div>
    {% endif %}
    {% if backup_result_message %}
        <div class="dm-updates-result {{ backup_result_error ? 'is-error' : 'is-success' }}" role="status">
            <strong>{{ backup_result_message }}</strong>
        </div>
    {% endif %}

    {% if pro_enabled and installations %}
        <section class="dm-updates-progress" data-dm-update-progress hidden aria-live="polite">
            <div class="dm-updates-progress-head">
                <strong data-dm-progress-title>Update-Prüfung</strong>
                <span data-dm-progress-counter>0 / 0</span>
            </div>
            <div
                class="dm-updates-progress-track"
                role="progressbar"
                aria-label="Fortschritt der Update-Aktion"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                data-dm-progress-track
            >
                <span class="dm-updates-progress-bar" data-dm-progress-bar></span>
            </div>
            <div class="dm-updates-progress-meta">
                <span data-dm-progress-current>Bereit.</span>
                <span data-dm-progress-summary></span>
            </div>
        </section>
    {% endif %}

    <div class="dm-updates-toolbar">
        <div class="dm-updates-tabs" role="group" aria-label="Update-Filter">
            <button type="button" class="is-active" data-dm-update-filter="attention">Handlungsbedarf</button>
            <button type="button" data-dm-update-filter="all">Alle Installationen</button>
            <button type="button" data-dm-update-filter="available" {% if not pro_enabled %}class="is-pro-locked" aria-disabled="true" data-dm-pro-hint{% endif %}>
                Updates verfügbar{% if not pro_enabled %} <span class="dm-pro-inline">Pro</span>{% endif %}
            </button>
            <button type="button" data-dm-update-filter="error">Prüfprobleme / Fehler</button>
        </div>
        <label class="dm-updates-search">
            <span>Installationen filtern</span>
            <input type="search" placeholder="Domain suchen …" data-dm-update-search>
        </label>
    </div>

    {% if pro_enabled and installations %}
        <div class="dm-updates-selection" data-dm-update-selection>
            <label class="dm-updates-select-visible">
                <input type="checkbox" data-dm-select-visible>
                <span>Seite auswählen</span>
            </label>
            <div class="dm-updates-selection-status" aria-live="polite">
                <span><strong data-dm-selected-count>0</strong> ausgewählt</span>
                <button type="button" data-dm-clear-selection disabled>Auswahl aufheben</button>
                <button type="button" class="is-primary" data-dm-check-selected disabled>Ausgewählte prüfen</button>
                <button type="button" class="is-warning" data-dm-install-selected disabled>Ausgewählte installieren</button>
            </div>
        </div>


    {% endif %}

    <div class="dm-updates-list" data-dm-update-list>
        {% for installation in installations %}
            <article
                class="dm-update-row{% if installation.id == result_installation_id %} is-result{% endif %}"
                data-dm-update-row
                data-installation-id="{{ installation.id }}"
                data-update-state="{{ installation.update_state }}"
                data-parent-domain="{{ installation.parent_domain|e('html_attr') }}"
                data-parent-id="{{ installation.pid }}"
                data-environment="{{ installation.environment|e('html_attr') }}"
                data-release-gap="{{ installation.update_release_gap ?? '' }}"
                data-search="{{ (installation.domain ~ ' ' ~ installation.parent_domain ~ ' ' ~ installation.environment_label)|lower|e('html_attr') }}"
            >
                {% if pro_enabled %}
                    <label class="dm-update-select" title="{{ installation.domain }} auswählen">
                        <input
                            type="checkbox"
                            value="{{ installation.id }}"
                            data-dm-update-select
                            aria-label="{{ installation.domain }} auswählen"
                        >
                    </label>
                {% endif %}

                <div class="dm-update-thumbnail{% if not installation.thumbnail_path %} is-empty{% endif %}" aria-hidden="true">
                    {% if installation.thumbnail_path %}
                        <img src="{{ installation.thumbnail_path|e('html_attr') }}" alt="" loading="lazy">
                    {% else %}
                        <span>—</span>
                    {% endif %}
                </div>

                <div class="dm-update-main">
                    <div class="dm-update-domain">
                        <strong>{{ installation.domain }}</strong>
                        {% if installation.parent_domain and installation.parent_domain != installation.domain %}
                            <span>Hauptdomain: {{ installation.parent_domain }}</span>
                        {% endif %}
                    </div>
                    <span class="dm-update-environment">{{ installation.environment_label }}</span>
                </div>

                <div class="dm-update-version">
                    <span>Contao</span>
                    <div class="dm-update-version-line">
                        <strong>{{ installation.contao_version ?: '—' }}</strong>
                        {% if installation.target_contao_version %}
                            <span class="dm-update-version-arrow" aria-hidden="true">→</span>
                            <strong class="dm-update-version-target">{{ installation.target_contao_version }}</strong>
                        {% endif %}
                    </div>
                </div>

                <div class="dm-update-state is-{{ installation.update_state }}{% if installation.update_release_gap >= 5 %} has-backlog{% endif %}">
                    {{ installation.update_state_label }}
                </div>

                <div class="dm-update-actions">
                    {% if installation.frontend_actions %}
                        {% for action in installation.frontend_actions %}
                            {% if installation.update_state != 'running' and action.name in ['update-check', 'update-install'] %}
                                {{ dm.action(action, contao.request_token) }}
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <button class="dm-updates-action is-locked is-pro-locked" type="button" aria-disabled="true" data-dm-pro-hint>Update prüfen <span>Pro</span></button>
                        <button class="dm-updates-action is-locked is-pro-locked" type="button" aria-disabled="true" data-dm-pro-hint>Installieren <span>Pro</span></button>
                        <button class="dm-updates-action is-locked is-pro-locked" type="button" aria-disabled="true" data-dm-pro-hint>Sicherungen <span>Pro</span></button>
                    {% endif %}
                </div>

                {% set detail = installation.update_details %}
                {% set backup_workspace = installation.frontend_metadata.backup_workspace ?? null %}
                {% if (detail and (detail.error_heading or detail.operations|length > 0)) or backup_workspace %}
                    <div class="dm-update-extra" data-dm-update-extra>
                        {% if detail and detail.error_heading %}
                            <details class="dm-update-error-inline{% if installation.update_state == 'error' %} is-installation-error{% endif %}">
                                <summary>
                                    <strong>{{ installation.update_state == 'error' ? 'Update fehlgeschlagen' : 'Letzte Update-Prüfung fehlgeschlagen' }}</strong>
                                    <span class="dm-update-error-preview">{{ detail.error_text|slice(0, 95) }}{% if detail.error_text|length > 95 %}…{% endif %}</span>
                                    <span class="dm-update-error-expand">Details anzeigen</span>
                                </summary>
                                <div class="dm-update-error-body">
                                    <p>{{ detail.error_text }}</p>
                                    {% if installation.update_state == 'check_failed' %}
                                        <p class="dm-update-error-context">Diese Meldung dokumentiert die letzte Composer-Prüfung. Sie bedeutet nicht, dass die Website ausgefallen ist.</p>
                                    {% endif %}
                                    {% if detail.has_backup %}
                                        <p class="dm-update-backup-note">Ein vor dem Update erstelltes Sicherheitsbackup ist vorhanden.</p>
                                    {% endif %}
                                </div>
                            </details>
                        {% endif %}

                        {% if detail and detail.operations|length > 0 %}
                            <details class="dm-update-plan" data-dm-update-plan>
                                <summary>
                                    <span>
                                        {{ detail.completed ? 'Letzter Paketplan (installiert)' : (detail.relevant ? 'Paketplan' : 'Vorheriger Paketplan') }}
                                        <strong>{{ detail.operations|length }} Paketänderungen</strong>
                                    </span>
                                    <span class="dm-update-plan-expand">Details anzeigen</span>
                                </summary>
                                <p class="dm-update-plan-caption">
                                    {{ detail.completed ? 'Plan der letzten abgeschlossenen Installation.' : (detail.relevant ? 'In der letzten Composer-Prüfung ermittelte Änderungen. Vor dem Installieren wird der Plan erneut überprüft.' : 'Historischer Paketplan. Für den aktuellen Stand bitte erneut prüfen.') }}
                                </p>
                                <div class="dm-update-plan-scroll">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th scope="col">Paket</th>
                                                <th scope="col">Bisher</th>
                                                <th scope="col">Geplant</th>
                                                <th scope="col">Aktion</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        {% for change in detail.operations %}
                                            <tr>
                                                <td><code>{{ change.package }}</code></td>
                                                <td>{{ change.from ?: '—' }}</td>
                                                <td>{{ change.to ?: '—' }}</td>
                                                <td>
                                                    {% if change.direction == 'downgrade' %}
                                                        <span class="dm-update-change is-downgrade">Downgrade</span>
                                                    {% elseif change.type == 'install' %}
                                                        <span class="dm-update-change">Neu</span>
                                                    {% elseif change.type == 'remove' %}
                                                        <span class="dm-update-change is-removal">Entfernung</span>
                                                    {% else %}
                                                        <span class="dm-update-change">Update</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        {% endif %}

                        {% if backup_workspace %}
                            <details id="dm-backups-{{ installation.id }}" class="dm-update-backups" data-dm-update-backups data-dm-restore-progress-url="{{ backup_workspace.restore_progress_url|default('')|e('html_attr') }}"{% if installation.id == backup_result_installation_id or backup_workspace.is_selected %} open{% endif %}>
                                <summary>
                                    <span><strong>Sicherungen</strong> <span class="dm-update-backups-count">{{ backup_workspace.backup_count }} {{ backup_workspace.backup_count == 1 ? 'Sicherung' : 'Sicherungen' }}</span></span>
                                    <span class="dm-update-backups-archive-size">{% if backup_workspace.total_size >= 1073741824 %}{{ (backup_workspace.total_size / 1073741824)|number_format(2, ',', '.') }} GB{% else %}{{ (backup_workspace.total_size / 1048576)|number_format(1, ',', '.') }} MB{% endif %} Archive</span>
                                    <span class="dm-update-backups-expand">Anzeigen</span>
                                </summary>
                                <div class="dm-update-backups-body">
                                    <div class="dm-update-backups-intro">
                                        <p>Die Sicherungen sind nach Datum sortiert und auf mehrere Seiten verteilt. Die Archivgröße umfasst die beim Erstellen gemessenen Datenbank- und Projektarchive; ob die Dateien noch auf dem Zielserver liegen, wird beim Wiederherstellen geprüft. Automatisch bleiben maximal fünf Sicherungen erhalten; manuelle Sicherungen bis zur Löschung.</p>
                                        <form action="{{ backup_workspace.create_url }}" method="post" class="dm-backup-create-form">
                                            <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                                            <input type="hidden" name="maintend_csrf" value="{{ backup_workspace.csrf_create }}">
                                            <button type="submit" class="dm-backup-button is-create">Jetzt sichern</button>
                                        </form>
                                    </div>
                                    <div class="dm-backup-progress" data-dm-backup-progress role="status" aria-live="polite" aria-atomic="true" hidden>
                                        Sicherung wird erstellt … Datenbank und Projektdateien werden gesichert. Bitte warten.
                                    </div>
                                    {% if backup_result_message and installation.id == backup_result_installation_id %}
                                        <div class="dm-backup-result{{ backup_result_error ? ' is-error' : ' is-success' }}" role="status" data-dm-backup-result>
                                            {{ backup_result_message }}
                                        </div>
                                    {% endif %}
                                    {% if not backup_workspace.history_available %}
                                        <p class="dm-update-backup-empty">Die Sicherungshistorie konnte nicht geladen werden.</p>
                                    {% elseif backup_workspace.backups is empty %}
                                        <p class="dm-update-backup-empty">Auf dieser Seite sind keine Sicherungen erfasst.</p>
                                    {% else %}
                                        <div class="dm-update-backup-list">
                                            {% for backup in backup_workspace.backups %}
                                                <div class="dm-update-backup-item">
                                                    <div class="dm-update-backup-item-main">
                                                        <strong>
                                                            {% if backup.source == 'pre_update' %}Vor Update
                                                            {% elseif backup.source == 'pre_restore' %}Vor Wiederherstellung
                                                            {% elseif backup.source == 'scheduled' %}Geplante Sicherung
                                                            {% else %}Manuelle Sicherung{% endif %}
                                                        </strong>
                                                        {% if backup.created_at > 0 %}
                                                            <span>{{ backup.created_at|date('d.m.Y, H.i') }} Uhr</span>
                                                        {% endif %}
                                                        <span>Contao {{ backup.contao_version ?: '—' }}</span>
                                                        <span>{{ (backup.project_size / 1048576)|number_format(1, ',', '.') }} MB Projekt</span>
                                                        <span>{{ (backup.database_size / 1024)|number_format(0, ',', '.') }} KB Datenbank</span>
                                                        <span class="dm-update-backup-status{% if backup.status != 'success' %} is-incomplete{% endif %}">{{ backup.status == 'success' ? 'Erfolgreich' : (backup.status == 'error' ? 'Fehlgeschlagen' : 'In Bearbeitung') }}</span>
                                                    </div>
                                                    {% if backup.restore_url %}
                                                        <details class="dm-update-backup-restore">
                                                            <summary>Wiederherstellen</summary>
                                                            <div class="dm-update-backup-warning">
                                                                <strong>Achtung: Vollständige Wiederherstellung</strong>
                                                                <p>Projektdateien, Composer-Pakete und Datenbank werden auf den Stand dieser Sicherung zurückgesetzt. Änderungen seitdem können verloren gehen. Vor dem Restore wird automatisch eine zusätzliche Sicherheitskopie erstellt.</p>
                                                                <p>Der normale Restore benötigt eine startfähige Contao-Installation. Ist die Zielseite nach einem Fehler nicht mehr erreichbar, kann eine manuelle Wiederherstellung über Hosting/SSH nötig sein.</p>
                                                                <form action="{{ backup.restore_url }}" method="post" class="dm-backup-restore-form">
                                                                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                                                                    <input type="hidden" name="maintend_csrf" value="{{ backup_workspace.csrf_restore }}">
                                                                    <label>
                                                                        Zur Bestätigung die Domain <strong>{{ installation.domain }}</strong> eingeben:
                                                                        <input type="text" name="confirm_domain" required autocomplete="off" spellcheck="false" placeholder="{{ installation.domain }}">
                                                                    </label>
                                                                    <label class="dm-backup-acknowledge">
                                                                        <input type="checkbox" name="acknowledge_restore" value="1" required>
                                                                        <span>Ich verstehe, dass Daten und Dateien auf den Sicherungsstand zurückgesetzt werden.</span>
                                                                    </label>
                                                                    <button type="submit" class="dm-backup-button is-destructive">Diese Sicherung wiederherstellen</button>
                                                                </form>
                                                            </div>
                                                        </details>
                                                    {% endif %}
                                                    {% if backup.delete_url %}
                                                        <details class="dm-update-backup-delete">
                                                            <summary>Sicherung löschen</summary>
                                                            <div class="dm-update-backup-warning">
                                                                <p>Diese Sicherung wird auf der Zielinstallation unwiderruflich gelöscht und aus maintend entfernt. Eine Wiederherstellung ist anschließend nicht mehr möglich.</p>
                                                                <form action="{{ backup.delete_url }}" method="post" class="dm-backup-delete-form">
                                                                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                                                                    <input type="hidden" name="maintend_csrf" value="{{ backup_workspace.csrf_delete }}">
                                                                    <label class="dm-backup-acknowledge">
                                                                        <input type="checkbox" name="confirm_delete" value="1" required>
                                                                        <span>Ich möchte diese Sicherung einschließlich der Dateien endgültig löschen.</span>
                                                                    </label>
                                                                    <button type="submit" class="dm-backup-button is-destructive">Endgültig löschen</button>
                                                                </form>
                                                            </div>
                                                        </details>
                                                    {% endif %}
                                                </div>
                                            {% endfor %}
                                        </div>
                                        {% if backup_workspace.pages > 1 %}
                                            <nav class="dm-backup-pages" aria-label="Sicherungsseiten für {{ installation.domain }}">
                                                <span>{{ backup_workspace.page_first }}–{{ backup_workspace.page_last }} von {{ backup_workspace.backup_count }} Sicherungen</span>
                                                <span class="dm-backup-pages-controls">
                                                    {% if backup_workspace.previous_url %}
                                                        <a href="{{ backup_workspace.previous_url }}">Neuere</a>
                                                    {% endif %}
                                                    <span>Seite {{ backup_workspace.page }} von {{ backup_workspace.pages }}</span>
                                                    {% if backup_workspace.next_url %}
                                                        <a href="{{ backup_workspace.next_url }}">Ältere</a>
                                                    {% endif %}
                                                </span>
                                            </nav>
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </details>
                        {% endif %}
                    </div>
                {% endif %}
            </article>
        {% else %}
            <p class="dm-updates-empty">Es sind noch keine Installationen hinterlegt.</p>
        {% endfor %}
    </div>

    <p class="dm-updates-empty" data-dm-update-empty hidden>Keine Installationen entsprechen dem gewählten Filter.</p>
</div>
{% endblock %}

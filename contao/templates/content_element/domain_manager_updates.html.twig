{% extends "@Contao/content_element/_base.html.twig" %}

{% use "@Contao/component/_stylesheet.html.twig" %}

{% add "domain_manager_layout_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-layout.css') ~ '?v=maintend-2'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_updates_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-updates.css') ~ '?v=maintend-3'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_navigation_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-navigation.css') ~ '?v=maintend-1'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_layout_js" to body %}
    <script src="{{ asset('bundles/contaodomainmanager/js/domain-manager-layout.js') ~ '?v=1.5.2' }}" defer></script>
{% endadd %}

{% add "domain_manager_updates_js" to body %}
    <script src="{{ asset('bundles/contaodomainmanager/js/domain-manager-updates.js') ~ '?v=1.5.7' }}" defer></script>
{% endadd %}

{% macro action(action, request_token) %}
    {% if action.method == 'post' %}
        <form
            class="dm-updates-action-form"
            action="{{ action.url }}"
            method="post"
            data-dm-action="{{ action.name|e('html_attr') }}"
        >
            <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
            <button
                class="dm-updates-action is-{{ action.variant }}"
                type="submit"
                data-dm-action-label="{{ action.label|e('html_attr') }}"
                {% if action.confirm %}data-dm-confirm="{{ action.confirm|e('html_attr') }}"{% endif %}
            >{{ action.label }}</button>
        </form>
    {% else %}
        <a class="dm-updates-action is-{{ action.variant }}" href="{{ action.url }}">{{ action.label }}</a>
    {% endif %}
{% endmacro %}

{% import _self as dm %}

{% block content %}
{% include "@Contao/components/domain_manager_workspace_navigation.html.twig" %}
<div class="dm-updates{% if pro_enabled %} has-selection{% endif %}" data-dm-updates>
    <header class="dm-updates-head">
        <div>
            <h2>Updates</h2>
            <p>Contao-Installationen zentral prüfen, vorbereiten und sicher aktualisieren.</p>
        </div>
        {% if pro_enabled %}
            <div class="dm-updates-summary" aria-label="Update-Übersicht">
                <div class="dm-updates-summary-item">
                    <strong>{{ total_count }}</strong>
                    <span>{{ total_count == 1 ? 'Installation' : 'Installationen' }}</span>
                </div>
                <div class="dm-updates-summary-item is-accent">
                    <strong data-dm-available-count>{{ available_count }}</strong>
                    <span>{{ available_count == 1 ? 'Update verfügbar' : 'Updates verfügbar' }}</span>
                </div>
                <div class="dm-updates-summary-item{% if error_count > 0 %} has-error{% endif %}">
                    <strong>{{ error_count }}</strong>
                    <span>{{ error_count == 1 ? 'Fehler' : 'Fehler' }}</span>
                </div>
            </div>
        {% else %}
            <span class="dm-pro-badge">Pro</span>
        {% endif %}
    </header>

    {% if not pro_enabled %}
        <div class="dm-updates-pro-teaser">
            <div>
                <strong>Update-Management in der Pro-Version</strong>
                <p>Updates prüfen, verfügbare Updates filtern, Sicherheitsbackups erstellen und Updates direkt installieren.</p>
            </div>
            <div class="dm-updates-pro-actions" aria-label="Pro-Funktionen">
                <button type="button" disabled>Updates prüfen <span>Pro</span></button>
                <button type="button" disabled>Updates installieren <span>Pro</span></button>
            </div>
        </div>
    {% endif %}

    {% if result_message %}
        <div class="dm-updates-result {{ install_status == 'error' or check_status in ['error', 'blocked'] ? 'is-error' : 'is-success' }}" role="status">
            <strong>{{ result_message }}</strong>
        </div>
    {% endif %}

    <div class="dm-updates-toolbar">
        <div class="dm-updates-tabs" role="group" aria-label="Update-Filter">
            <button type="button" class="is-active" data-dm-update-filter="all">Alle Installationen</button>
            <button type="button" data-dm-update-filter="available" {% if not pro_enabled %}disabled title="Nur in der Pro-Version verfügbar"{% endif %}>
                Updates verfügbar{% if not pro_enabled %} <span class="dm-pro-inline">Pro</span>{% endif %}
            </button>
            <button type="button" data-dm-update-filter="error">Fehler</button>
        </div>
        <label class="dm-updates-search">
            <span>Installationen filtern</span>
            <input type="search" placeholder="Domain suchen …" data-dm-update-search>
        </label>
    </div>

    {% if pro_enabled and installations %}
        <div class="dm-updates-selection" data-dm-update-selection>
            <label class="dm-updates-select-visible">
                <input type="checkbox" data-dm-select-visible>
                <span>Sichtbare auswählen</span>
            </label>
            <div class="dm-updates-selection-status" aria-live="polite">
                <span><strong data-dm-selected-count>0</strong> ausgewählt</span>
                <button type="button" data-dm-clear-selection disabled>Auswahl aufheben</button>
                <button type="button" class="is-primary" data-dm-check-selected disabled>Ausgewählte prüfen</button>
                <button type="button" class="is-warning" data-dm-install-selected disabled>Ausgewählte installieren</button>
            </div>
        </div>

        <section class="dm-updates-progress" data-dm-update-progress hidden aria-live="polite">
            <div class="dm-updates-progress-head">
                <strong data-dm-progress-title>Update-Prüfung</strong>
                <span data-dm-progress-counter>0 / 0</span>
            </div>
            <div
                class="dm-updates-progress-track"
                role="progressbar"
                aria-label="Fortschritt der Update-Aktion"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                data-dm-progress-track
            >
                <span class="dm-updates-progress-bar" data-dm-progress-bar></span>
            </div>
            <div class="dm-updates-progress-meta">
                <span data-dm-progress-current>Bereit.</span>
                <span data-dm-progress-summary></span>
            </div>
        </section>
    {% endif %}

    <div class="dm-updates-list" data-dm-update-list>
        {% for installation in installations %}
            <article
                class="dm-update-row{% if installation.id == result_installation_id %} is-result{% endif %}"
                data-dm-update-row
                data-installation-id="{{ installation.id }}"
                data-update-state="{{ installation.update_state }}"
                data-search="{{ (installation.domain ~ ' ' ~ installation.parent_domain ~ ' ' ~ installation.environment_label)|lower|e('html_attr') }}"
            >
                {% if pro_enabled %}
                    <label class="dm-update-select" title="{{ installation.domain }} auswählen">
                        <input
                            type="checkbox"
                            value="{{ installation.id }}"
                            data-dm-update-select
                            aria-label="{{ installation.domain }} auswählen"
                        >
                    </label>
                {% endif %}

                <div class="dm-update-thumbnail{% if not installation.thumbnail_path %} is-empty{% endif %}" aria-hidden="true">
                    {% if installation.thumbnail_path %}
                        <img src="{{ installation.thumbnail_path|e('html_attr') }}" alt="" loading="lazy">
                    {% else %}
                        <span>—</span>
                    {% endif %}
                </div>

                <div class="dm-update-main">
                    <div class="dm-update-domain">
                        <strong>{{ installation.domain }}</strong>
                        {% if installation.parent_domain and installation.parent_domain != installation.domain %}
                            <span>Hauptdomain: {{ installation.parent_domain }}</span>
                        {% endif %}
                    </div>
                    <span class="dm-update-environment">{{ installation.environment_label }}</span>
                </div>

                <div class="dm-update-version">
                    <span>Contao</span>
                    <div class="dm-update-version-line">
                        <strong>{{ installation.contao_version ?: '—' }}</strong>
                        {% if installation.target_contao_version %}
                            <span class="dm-update-version-arrow" aria-hidden="true">→</span>
                            <strong class="dm-update-version-target">{{ installation.target_contao_version }}</strong>
                        {% endif %}
                    </div>
                </div>

                <div class="dm-update-state is-{{ installation.update_state }}">
                    {{ installation.update_state_label }}
                </div>

                <div class="dm-update-actions">
                    {% if installation.frontend_actions %}
                        {% for action in installation.frontend_actions %}
                            {% if action.name in ['update-check', 'update-install'] %}
                                {{ dm.action(action, contao.request_token) }}
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <button class="dm-updates-action is-locked" type="button" disabled title="Nur in der Pro-Version verfügbar">Update prüfen <span>Pro</span></button>
                        <button class="dm-updates-action is-locked" type="button" disabled title="Nur in der Pro-Version verfügbar">Installieren <span>Pro</span></button>
                    {% endif %}
                </div>

                {% set detail = installation.update_details %}
                {% if detail and (detail.error_heading or detail.operations|length > 0) %}
                    <div class="dm-update-extra" data-dm-update-extra>
                        {% if detail.error_heading %}
                            <div class="dm-update-error-inline" role="status">
                                <strong>{{ detail.error_heading }}</strong>
                                <span>{{ detail.error_text|slice(0, 220) }}{% if detail.error_text|length > 220 %}…{% endif %}</span>
                                {% if detail.has_backup %}
                                    <small>Ein vor dem Update erstelltes Sicherheitsbackup ist vorhanden.</small>
                                {% endif %}
                                {% if detail.error_text|length > 220 %}
                                    <details class="dm-update-error-full">
                                        <summary>Vollständige Fehlermeldung</summary>
                                        <p>{{ detail.error_text }}</p>
                                    </details>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% if detail.operations|length > 0 %}
                            <details class="dm-update-plan" data-dm-update-plan>
                                <summary>
                                    <span>
                                        {{ detail.completed ? 'Letzter Paketplan (installiert)' : (detail.relevant ? 'Paketplan' : 'Vorheriger Paketplan') }}
                                        <strong>{{ detail.operations|length }} Paketänderungen</strong>
                                    </span>
                                    <span class="dm-update-plan-expand">Details anzeigen</span>
                                </summary>
                                <p class="dm-update-plan-caption">
                                    {{ detail.completed ? 'Plan der letzten abgeschlossenen Installation.' : (detail.relevant ? 'In der letzten Composer-Prüfung ermittelte Änderungen. Vor dem Installieren wird der Plan erneut überprüft.' : 'Historischer Paketplan. Für den aktuellen Stand bitte erneut prüfen.') }}
                                </p>
                                <div class="dm-update-plan-scroll">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th scope="col">Paket</th>
                                                <th scope="col">Bisher</th>
                                                <th scope="col">Geplant</th>
                                                <th scope="col">Aktion</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        {% for change in detail.operations %}
                                            <tr>
                                                <td><code>{{ change.package }}</code></td>
                                                <td>{{ change.from ?: '—' }}</td>
                                                <td>{{ change.to ?: '—' }}</td>
                                                <td>
                                                    {% if change.direction == 'downgrade' %}
                                                        <span class="dm-update-change is-downgrade">Downgrade</span>
                                                    {% elseif change.type == 'install' %}
                                                        <span class="dm-update-change">Neu</span>
                                                    {% elseif change.type == 'remove' %}
                                                        <span class="dm-update-change is-removal">Entfernung</span>
                                                    {% else %}
                                                        <span class="dm-update-change">Update</span>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        {% endif %}
                    </div>
                {% endif %}
            </article>
        {% else %}
            <p class="dm-updates-empty">Es sind noch keine Installationen hinterlegt.</p>
        {% endfor %}
    </div>

    <p class="dm-updates-empty" data-dm-update-empty hidden>Keine Installationen entsprechen dem gewählten Filter.</p>
</div>
{% endblock %}

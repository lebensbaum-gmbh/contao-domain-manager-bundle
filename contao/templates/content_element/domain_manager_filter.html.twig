{% extends "@Contao/content_element/_base.html.twig" %}

{% use "@Contao/component/_stylesheet.html.twig" %}

{% add "domain_manager_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager.css')} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_layout_css" to stylesheets %}
    {% with {file: asset('bundles/contaodomainmanager/css/domain-manager-layout.css') ~ '?v=1.5.1'} %}
        {{ block('stylesheet_component') }}
    {% endwith %}
{% endadd %}

{% add "domain_manager_js" to body %}
    <script src="{{ asset('bundles/contaodomainmanager/js/domain-manager.js') }}" defer></script>
{% endadd %}

{% add "domain_manager_layout_js" to body %}
    <script src="{{ asset('bundles/contaodomainmanager/js/domain-manager-layout.js') }}" defer></script>
{% endadd %}

{% block content %}
<aside class="domain-manager-filter" data-domain-manager-filter>
    <h2 class="dm-filter-title">Filter</h2>

    <div class="dm-filter-section">
        <label class="dm-filter-label" for="dm-filter-search-{{ id|default('overview') }}">Suche</label>
        <input
            id="dm-filter-search-{{ id|default('overview') }}"
            class="dm-filter-search"
            type="search"
            placeholder="Domain durchsuchen …"
            autocomplete="off"
            data-dm-filter-search
        >
    </div>

    <div class="dm-filter-section dm-filter-current">
        <label class="dm-filter-check">
            <input type="checkbox" data-dm-filter-current>
            <span>Nur aktuelle Ziele</span>
        </label>
    </div>

    <div class="dm-filter-section">
        <h3 class="dm-filter-heading">Status</h3>
        <label class="dm-filter-check">
            <input type="checkbox" value="ok" data-dm-filter-health>
            <span>OK</span>
        </label>
        <label class="dm-filter-check">
            <input type="checkbox" value="warning" data-dm-filter-health>
            <span>Hinweis</span>
        </label>
        <label class="dm-filter-check">
            <input type="checkbox" value="error" data-dm-filter-health>
            <span>Fehler</span>
        </label>
    </div>

    {% if external_services %}
        <div class="dm-filter-section">
            <h3 class="dm-filter-heading">Externe Dienste</h3>
            {% for service in external_services %}
                <label class="dm-filter-check">
                    <input type="checkbox" value="{{ service.id }}" data-dm-filter-service>
                    <span>{{ service.name }}</span>
                </label>
            {% endfor %}
            <label class="dm-filter-check">
                <input type="checkbox" value="none" data-dm-filter-service>
                <span>Keinem Dienst zugeordnet</span>
            </label>
        </div>
    {% endif %}

    {% if contao_versions %}
        <div class="dm-filter-section">
            <h3 class="dm-filter-heading">Contao Version</h3>
            {% for version in contao_versions %}
                <label class="dm-filter-check">
                    <input type="checkbox" value="{{ version|e('html_attr') }}" data-dm-filter-contao>
                    <span>{{ version }}</span>
                </label>
            {% endfor %}
        </div>
    {% endif %}

    {% if php_versions %}
        <div class="dm-filter-section">
            <h3 class="dm-filter-heading">PHP-Version</h3>
            {% for version in php_versions %}
                <label class="dm-filter-check">
                    <input type="checkbox" value="{{ version|e('html_attr') }}" data-dm-filter-php>
                    <span>PHP {{ version }}</span>
                </label>
            {% endfor %}
        </div>
    {% endif %}

    {% if environments %}
        <div class="dm-filter-section">
            <h3 class="dm-filter-heading">Umgebung</h3>
            {% for value, label in environments %}
                <label class="dm-filter-check">
                    <input type="checkbox" value="{{ value|e('html_attr') }}" data-dm-filter-environment>
                    <span>{{ label }}</span>
                </label>
            {% endfor %}
        </div>
    {% endif %}

    <button type="button" class="dm-filter-reset" data-dm-filter-reset>Filter zurücksetzen</button>
</aside>


{% endblock %}

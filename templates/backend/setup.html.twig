{% extends '@Contao/be_main' %}

{% block main_content %}
    <div class="tl_listing_container">
        <div style="padding:20px 24px;max-width:1100px">
            <p style="margin:0 0 18px;color:var(--text-color, #555)">
                Der Assistent prüft, welche Bausteine der empfohlenen Domainverwaltung bereits vorhanden sind.
                Vorhandene Bausteine werden wiederverwendet; angelegt wird nur, was fehlt.
            </p>

            {% if success %}
                <div class="tl_confirm" style="margin:0 0 20px">{{ success }}</div>
            {% endif %}
            {% if error %}
                <div class="tl_error" style="margin:0 0 20px">{{ error }}</div>
            {% endif %}

            {% if setup.complete %}
                <div class="tl_confirm" style="margin:0 0 20px">
                    Die empfohlene Grundstruktur ist vollständig vorhanden.
                </div>
            {% else %}
                <div class="tl_info" style="margin:0 0 20px">
                    {{ setup.found }} von {{ setup.total }} Bausteinen wurden erkannt. Die fehlenden Bausteine können automatisch ergänzt werden.
                </div>
            {% endif %}

            {% if setup.complete and not setup.frontend_access.ready %}
                <div class="tl_info" style="margin:0 0 20px;padding:14px 16px 14px 42px">
                    <strong>Nächster manueller Schritt: Frontend-Mitglied anlegen</strong>
                    <p style="margin:7px 0 0">
                        Legen Sie im Backend unter „Mitglieder“ ein Frontend-Mitglied an, aktivieren Sie die Anmeldung und weisen Sie das Mitglied der Mitgliedergruppe „Domainverwaltung“ zu.
                        Erst danach ist die Anmeldung an der Domainübersicht möglich.
                    </p>
                </div>
            {% elseif setup.complete and setup.frontend_access.ready %}
                <div class="tl_confirm" style="margin:0 0 20px;padding:14px 16px">
                    <strong>Frontend-Zugang vorbereitet.</strong>
                    {% if setup.frontend_access.username %}
                        Das aktive Mitglied „{{ setup.frontend_access.username }}“ ist der Mitgliedergruppe „Domainverwaltung“ zugeordnet.
                    {% else %}
                        Mindestens ein aktives Mitglied ist der Mitgliedergruppe „Domainverwaltung“ zugeordnet.
                    {% endif %}
                </div>
            {% endif %}

            <table class="tl_listing" style="width:100%;margin:0 0 24px">
                <thead>
                    <tr>
                        <th style="padding:9px 12px;text-align:left">Baustein</th>
                        <th style="padding:9px 12px;text-align:left">Erwartet</th>
                        <th style="padding:9px 12px;text-align:left;width:160px">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in setup.items %}
                        <tr>
                            <td style="padding:9px 12px"><strong>{{ item.label }}</strong></td>
                            <td style="padding:9px 12px">{{ item.expected }}</td>
                            <td style="padding:9px 12px">
                                {% if item.found %}
                                    <span style="color:#26734d;font-weight:600">✓ vorhanden</span>
                                    {% if item.id %}<small style="color:#777"> (ID {{ item.id }})</small>{% endif %}
                                {% else %}
                                    <span style="color:#956515;font-weight:600">○ fehlt</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if not setup.complete %}
                <div class="tl_box" style="padding:16px 18px;max-width:900px">
                    <strong>Fehlende Einrichtung ergänzen</strong>
                    <p style="margin:8px 0 14px">
                        Der Assistent legt fehlende Bausteine in einer Transaktion an und verwendet bereits vorhandene Bausteine weiter.
                        Ein erneuter Aufruf erzeugt keine Duplikate.
                    </p>

                    <form method="post">
                        <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                        <input type="hidden" name="dm_setup_action" value="complete_setup">

                        {% if needs_hostname %}
                            <div class="widget" style="max-width:520px;margin:0 0 14px">
                                <label for="dm_setup_hostname" style="display:block;font-weight:600;margin:0 0 5px">Hostname der Domainverwaltung</label>
                                <input
                                    type="text"
                                    id="dm_setup_hostname"
                                    name="dm_setup_hostname"
                                    class="tl_text"
                                    value="{{ default_hostname }}"
                                    maxlength="255"
                                    required
                                >
                                <p class="tl_help" style="margin-top:5px">
                                    Der Hostname wird nur beim Anlegen eines neuen Startpunkts verwendet. Empfohlen ist eine eigene (Sub-)Domain für die Domainverwaltung.
                                </p>
                            </div>
                        {% else %}
                            <input type="hidden" name="dm_setup_hostname" value="{{ default_hostname }}">
                        {% endif %}

                        <button
                            type="submit"
                            class="tl_submit"
                            onclick="return confirm('Fehlende Bausteine der Domainverwaltung automatisch ergänzen?')"
                        >Einrichtung vervollständigen</button>
                    </form>
                </div>
            {% else %}
                <div class="tl_box" style="padding:16px 18px;max-width:900px">
                    <strong>Einrichtung vollständig</strong>
                    <p style="margin:8px 0 0">
                        Theme, Seitenstruktur, Login und Domain-Manager-Inhaltselemente wurden erkannt.
                        {% if setup.frontend_access.ready %}
                            Der Frontend-Zugang ist ebenfalls vorbereitet.
                        {% else %}
                            Für den Frontend-Zugang fehlt nur noch ein aktives Mitglied in der Mitgliedergruppe „Domainverwaltung“.
                        {% endif %}
                    </p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
